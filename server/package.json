{
  "name": "brevly-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file .env src/infra/http/server.ts",
    "build": "tsup-node",
    "start": "node dist/infra/http/server.js",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "pretest": "pnpm run db:migrate:test",
    "pretest:watch": "pnpm run db:migrate:test",
    "lint": "biome check ./src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/lib-storage": "^3.1168.0",
    "@fastify/cors": "^11.4.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
